---
import { getCollection } from "astro:content";
import { postSlug } from "../utils/posts";

const pinnedPosts = (await getCollection("blog"))
  .map((post) => ({ ...post.data, slug: postSlug(post) }))
  .filter((post) => typeof post.featuredRank === "number")
  .sort((a, b) => (a.featuredRank ?? 99) - (b.featuredRank ?? 99))
  .slice(0, 5);
---

{pinnedPosts.length > 0 && (
  <section class="pinned-articles" aria-labelledby="pinned-articles-title">
    <div class="pinned-copy">
      <p class="eyebrow">Pinned articles</p>
      <h2 id="pinned-articles-title">บทความปักหมุด</h2>
      <p>บทความที่อยากให้คนอ่านเห็นก่อน คุมลำดับได้เองจากไฟล์บทความ ไม่ผูกกับยอดวิว</p>
    </div>
    <ol>
      {pinnedPosts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}/`}>{post.title}</a>
          <small>{post.category}</small>
        </li>
      ))}
    </ol>
  </section>
)}
