---
import { getCollection } from "astro:content";
import { postSlug } from "../utils/posts";

const posts = (await getCollection("blog"))
  .map((post) => ({ ...post.data, slug: postSlug(post) }))
  .sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime())
  .slice(0, 5);
---

<section class="site-insights" aria-labelledby="insights-title">
  <div class="insights-summary">
    <p class="eyebrow">Website insights</p>
    <h2 id="insights-title">ยอดเข้าชมเว็บไซต์</h2>
    <div class="insight-number" data-analytics-total>พร้อมเชื่อมต่อ</div>
    <p>
      บล็อกนี้เตรียมไว้สำหรับแสดงยอดเข้าชมจริงจาก Analytics เมื่อเชื่อมต่อ Cloudflare Web Analytics
      หรือ webhook เก็บ pageview แล้ว ระบบจะเปลี่ยนจากสถานะนี้เป็นตัวเลขจริงได้
    </p>
  </div>

  <div class="popular-posts">
    <div class="popular-head">
      <h3>ไฮไลท์ 5 บทความที่ควรติดตามยอด</h3>
      <span>รอต่อข้อมูลยอดวิวจริง</span>
    </div>
    <ol>
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}/`}>{post.title}</a>
          <small>{post.category}</small>
        </li>
      ))}
    </ol>
  </div>
</section>
