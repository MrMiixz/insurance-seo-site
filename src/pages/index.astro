---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { postSlug } from "../utils/posts";

const posts = (await getCollection("blog"))
  .map((post) => ({ ...post.data, slug: postSlug(post) }))
  .sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
---

<BaseLayout>
  <section class="container hero">
    <div>
      <p class="eyebrow">พี่มิกคลิกทุกแผน</p>
      <h1>อ่านเรื่องประกันให้เข้าใจ ก่อนเลือกแผนที่ใช่กับชีวิตจริง</h1>
      <p class="lead">รวมบทความประกันสุขภาพ ประกันชีวิต และการวางแผนความเสี่ยงแบบภาษาคนทั่วไป ช่วยให้เห็นจุดที่ควรถามก่อนซื้อ และทัก LINE OA เพื่อให้ช่วยออกแบบแผนต่อได้</p>
      <div class="actions">
        <a class="button" href="/blog/">อ่านบทความล่าสุด</a>
        <a class="button secondary" href="https://lin.ee/pISkWyf" rel="noopener noreferrer">ทัก LINE OA</a>
      </div>
    </div>
    <aside class="hero-panel">
      <p class="eyebrow">เริ่มจากคำถามที่คนเจอจริง</p>
      <h2>ป่วยหนึ่งครั้ง ต้องเตรียมเงินเท่าไหร่ และประกันช่วยตรงไหนได้บ้าง</h2>
      <div class="stat-list">
        <div class="stat"><strong>เช็กความเสี่ยง</strong><span>ค่าห้อง ค่าหมอ ค่ายา ผ่าตัด OPD/IPD และเงินสำรอง</span></div>
        <div class="stat"><strong>อ่านเงื่อนไขก่อนตัดสินใจ</strong><span>ดูวงเงิน ข้อยกเว้น Co-payment และความสามารถในการจ่ายเบี้ยระยะยาว</span></div>
        <div class="stat"><strong>คุยต่อแบบมีโจทย์</strong><span>เตรียมข้อมูลให้พร้อมก่อนทัก เพื่อออกแบบแผนได้ตรงขึ้น</span></div>
      </div>
    </aside>
  </section>

  <section class="section-band">
    <div class="container">
      <h2>บทความล่าสุด</h2>
      <div class="article-list">
        {posts.map((post) => (
          <article class="card article-card">
            <p class="meta">{post.category} · {new Date(post.publishDate).toLocaleDateString("th-TH")}</p>
            <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
            <p>{post.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="container grid">
      <div class="card">
        <h3>ก่อนซื้อประกันสุขภาพ</h3>
        <p>ชวนดูคำถามสำคัญ เช่น เลือกวงเงินเท่าไหร่ดี มี OPD จำเป็นไหม และค่ารักษาโรงพยาบาลเอกชนควรเตรียมเงินสำรองแค่ไหน</p>
      </div>
      <div class="card">
        <h3>ก่อนวางแผนครอบครัว</h3>
        <p>ช่วยคิดเรื่องรายได้ หนี้สิน คนที่ต้องดูแล และเงินก้อนที่ครอบครัวควรมี ถ้าวันหนึ่งเราไม่สามารถหารายได้เหมือนเดิม</p>
      </div>
      <div class="card">
        <h3>ก่อนตัดสินใจจากเบี้ย</h3>
        <p>เบี้ยถูกหรือวงเงินสูงไม่ใช่คำตอบเดียว สิ่งที่ควรดูคือเงื่อนไขจริง ข้อยกเว้น ระยะยาว และแผนเดิมที่มีอยู่แล้ว</p>
      </div>
    </div>
  </section>
</BaseLayout>
