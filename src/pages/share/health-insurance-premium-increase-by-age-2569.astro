---
const title = "เบี้ยประกันสุขภาพเพิ่มตามอายุ วางแผนยังไงไม่ให้จ่ายไม่ไหว | พี่มิก ไทยประกัน";
const description = "เช็กวิธีวางแผนเบี้ยประกันสุขภาพที่อาจเพิ่มตามอายุ ให้ยังมีความคุ้มครองต่อเนื่อง โดยไม่ให้เบี้ยปีต่อไปกลายเป็นภาระเกินตัว";
const siteUrl = "https://insurance-by-miixz.pages.dev";
const articleUrl = `${siteUrl}/blog/health-insurance-premium-increase-by-age-2569/`;
const shareUrl = `${siteUrl}/share/health-insurance-premium-increase-by-age-2569/`;
const imageUrl = `${siteUrl}/images/health-insurance-premium-increase-by-age-2569-og.jpg`;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
