---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTABox from "../components/CTABox.astro";
---

<BaseLayout title="ติดต่อพี่มิกคลิกทุกแผน" description="ช่องทางทัก LINE OA เพื่อเช็กแผนประกันสุขภาพ ประกันชีวิต และการวางแผนความเสี่ยง">
  <section class="container article-header">
    <p class="eyebrow">Contact</p>
    <h1>ทักคุยเรื่องแผนประกันผ่าน LINE OA</h1>
    <p class="lead">เล่าโจทย์ งบประมาณ โรงพยาบาลที่ใช้ และประกันเดิมที่มีได้ครับ จะช่วยไล่คำถามก่อนเลือกแผนให้รอบคอบขึ้น</p>
  </section>
  <section class="container">
    <CTABox />
    <div class="tool-box">
      <h2>ข้อมูลผู้ให้บริการ</h2>
      <p>สวัสดีครับ ภาคิณ ทิพย์เดชาทร ตัวแทนไทยประกันชีวิต เลขที่ใบอนุญาต 5001042234 ยินดีให้บริการครับ</p>
      <p>Tel. 082-9424666</p>
      <p class="meta">#พี่มิกคลิกทุกแผน #พี่มิกไทยประกัน #ตัวแทนประกันชีวิตหาดใหญ่ #ตัวแทนประกันหาดใหญ่ #ไทยประกันชีวิตหาดใหญ่ #ไทยประกันชีวิต #ประกันชีวิต #ประกันออนไลน์ #ประกันสุขภาพ #ลดหย่อนภาษี</p>
    </div>
  </section>
</BaseLayout>
